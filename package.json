{
  "name": "playwright-toolshop-framework",
  "version": "1.0.0",
  "private": true,
  "description": "UI + API test automation framework for practicesoftwaretesting.com (Toolshop)",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:headed": "playwright test --project=ui --headed",
    "report": "playwright show-report reports/html",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.7",
    "dotenv": "^16.4.7",
    "eslint": "^9.19.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "zod": "^3.24.1"
  }
}
